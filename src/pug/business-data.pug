mixin routeSchedule()
  ul
    each route in business.routes
      li #{routeName(route)} — #{route.schedule}.

mixin deliveryTerms()
  ul
    each route in business.routes.filter((item) => item.days)
      li
        if route.usualDays
          | #{routeName(route)} — обычно #{route.usualDays} #{route.usualDays === 1 ? 'сутки' : 'суток'}; гарантированный срок — до #{route.days} календарных суток.
        else
          | #{routeName(route)} — гарантированный срок до #{route.days} календарных суток.
  p Гарантированные сроки считаются от приёма груза и действуют для любого принятого груза по указанным направлениям.

mixin storageTerms()
  p=business.storage.start
  ul
    li=business.storage.small
    li=business.storage.large
  p Цены включают НДС.
