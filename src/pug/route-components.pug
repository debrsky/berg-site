mixin routeActions(origin, destination, position, calculatorLabel = "Рассчитать стоимость")
  .route-landing__actions
    a.button.button--primary(href="calculator.html?origin=" + origin + "&destination=" + destination, target="_blank", rel="noopener", title="Откроется в новой вкладке", data-route-id=origin + "-" + destination, data-route-goal="calculator", data-cta-position=position)=calculatorLabel
    a.button(href="order.html?origin=" + origin + "&destination=" + destination, target="_blank", rel="noopener", title="Откроется в новой вкладке", data-route-id=origin + "-" + destination, data-route-goal="order", data-cta-position=position) Оформить заявку

mixin routePhone(phone, origin, destination, position)
  .route-landing__phone-row
    a.route-landing__phone(href="tel:" + phone.number, data-route-id=origin + "-" + destination, data-route-goal="phone", data-cta-position=position)=phone.text
    button.route-landing__copy(type="button", data-copy-phone=phone.number, aria-label="Скопировать номер " + phone.text, hidden)
      svg(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.6", aria-hidden="true", focusable="false")
        rect(x="8", y="8", width="12", height="13", rx="2")
        path(d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3")
    span.route-landing__copy-status(role="status", aria-live="polite", aria-atomic="true", hidden)

mixin routeTariffs(origin, destination)
  -
    const fmt = (value) => value.toLocaleString("ru-RU", {maximumFractionDigits: 10});
    const groups = [
      {title: "Тяжёлый груз", unit: "руб./кг", measure: "кг", rows: tariffs.heavyCargoPrices},
      {title: "Лёгкий груз", unit: "руб./м³", measure: "м³", rows: tariffs.lightCargoPrices}
    ];
  .route-landing__tariffs
    .route-landing__tariff-card
      table.route-landing__table
        caption
          span.route-landing__tariff-title Минимальные категории
          | #{" "}
          span.route-landing__tariff-unit руб. за отправку
        thead
          tr
            th(scope="col") Масса и объём одновременно
            th(scope="col") Сумма
        tbody
          each row, idx in tariffs.minPrices
            tr
              th(scope="row")
                if idx === 0
                  | Документы:
                else
                  | Иначе:
                span.route-landing__limit
                  | менее#{" "}
                  span.route-landing__nowrap #{fmt(row.limitHeavy)} кг
                span.route-landing__limit
                  | и#{"\u00a0"}менее#{" "}
                  span.route-landing__nowrap #{fmt(row.limitLight)} м³
              td=fmt(row.price[origin][destination])
    each group in groups
      .route-landing__tariff-card
        table.route-landing__table
          caption
            span.route-landing__tariff-title=group.title
            | #{" "}
            span.route-landing__tariff-unit=group.unit
          thead
            tr
              th(scope="col") Диапазон, #{group.measure}
              th(scope="col") Ставка
          tbody
            each row, idx in group.rows
              tr
                if row.limit === Infinity
                  th.route-landing__machine-trip(scope="row", colspan="2")
                    span.route-landing__limit От#{"\u00a0"}#{fmt(group.rows[idx - 1].limit)} #{group.measure}
                    | Машинорейс#{" "}
                    span.route-landing__nowrap по договорённости
                else
                  th(scope="row")
                    if idx === 0
                      | менее#{"\u00a0"}#{fmt(row.limit)}
                    else
                      | от#{"\u00a0"}#{fmt(group.rows[idx - 1].limit)} до#{"\u00a0"}#{fmt(row.limit)}
                  td=fmt(row.price[origin][destination])
  p Верхняя граница обычного диапазона не включается: на границе применяется следующая строка. Для минимальных категорий должны одновременно выполняться оба условия; выбирается первая подходящая.

mixin routeExamples(origin, destination)
  -
    const samples = [
      {title: "Документы", icon: "documents", note: "Небольшой пакет бумаг", weight: 0.3, volume: 0.001},
      {title: "Мелкое отправление", icon: "parcel", note: "Компактный груз в коробке", weight: 10, volume: 0.1},
      {title: "Тяжёлый груз", icon: "pallet", note: "Большой вес при небольшом объёме", weight: 500, volume: 1},
      {title: "Объёмный груз", icon: "volume", note: "Лёгкий, но занимает много места", weight: 100, volume: 1}
    ];
    const fmtSample = (value) => value.toLocaleString("ru-RU", {maximumFractionDigits: 3});
  .route-landing__examples
    each sample in samples
      -const result = calculateCargo(tariffs, {...sample, origin, destination, params: []});
      .route-landing__example
        .route-landing__example-heading
          != landingCargo(origin + "-" + destination, sample.icon)
          .route-landing__example-caption
            h3.route-landing__example-title=sample.title
            p.route-landing__example-note=sample.note
        p.route-landing__sample
          span.route-landing__nowrap #{fmtSample(sample.weight)}#{"\u00a0"}кг
          span.route-landing__sample-divider(aria-hidden="true")=" / "
          span.visually-hidden=", объём "
          span.route-landing__nowrap #{fmtSample(sample.volume)}#{"\u00a0"}м³
        p.route-landing__amount
          | #{result.amount.toLocaleString("ru-RU")}#{"\u00a0"}
          span.route-landing__amount-unit руб.
