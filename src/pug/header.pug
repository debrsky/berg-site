header.header.container
  .logo
    a.logo__icon(href="home.html", aria-label="Главная страница сайта")
      span.logo__artwork(aria-hidden="true")
        svg(width="147", height="62", role="presentation")
          use(xlink:href="#logo")
    div.logo__text #[span.visually-hidden Берг] Транспортная #[br] компания
    .logo__slogan Автоперевозки грузов по Дальнему Востоку
  #contacts.contacts
    address.contacts__address
      .contacts__place-selector.suggest-helper
        label.visually-hidden(for="contacts__place-selector") Город терминала
        select#contacts__place-selector.suggest-helper__label
          each code, idx in ['vvo', 'uss', 'khb', 'blg']
            option(data-city=code, selected=idx === 0)=tariffs.places[code]
      each code, idx in ['vvo', 'uss', 'khb', 'blg']
        span.contacts__address-text(data-place=tariffs.places[code], hidden=idx !== 0)=tariffs.terminals[code]
    each code, idx in ['vvo', 'uss', 'khb', 'blg']
      .contacts__phones(data-place=tariffs.places[code], hidden=idx !== 0)
        each phone, phoneIdx in business.terminals[code].phones.filter((item) => item.header)
          if phoneIdx
            br
          a(href="tel:" + phone.number)=phone.text
    .contacts__email
      a(href="mailto:" + business.email)=business.email
    .contacts__instagram
      a.instagram(href="https://www.instagram.com/tc_berg/" target="_blank" rel="noopener" style="position: relative; padding-left: 2.5ch;")
        img(src="img/instagram.svg", alt="", width="16", height="16", style="position: absolute; top: 0.2em; left: 0; height: 1em; width: auto;")
        span tc_berg
