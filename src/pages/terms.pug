extends ../pug/layout
block variables
  -
    title = "Условия перевозки груза"
    pagePath = "terms.html"
    pageClass = "page--information"
    description = "Условия ТК Берг: гарантированные сроки доставки, время сдачи груза, выдача, платное хранение после прибытия и подготовка к перевозке."

block content
  article
    h1.h2 Условия перевозки груза
    section
      h2.h3 Гарантированные сроки доставки
      +deliveryTerms()
    section
      h2.h3 Сдача и выдача груза
      p=business.applicationDeadline
      p=business.dispatchOptions
      p=business.deliveryOptions
      p=business.reception
      p Обычно машины отправляются не ранее 15:00. Это не фиксированное время отправки и не гарантия отправки груза после 11:00.
      p=business.collection
    section
      h2.h3 Хранение после прибытия
      +storageTerms()
    section
      h2.h3 Подготовка груза
      p=business.packagingNotice
      p Требования и тарифы — в разделе #[a.link(href="package.html") «Упаковка»].
      p=business.temperature
      p Требования к документам и бланки размещены в разделе #[a.link(href="docs.html") «Документы»]. Условия перевозки конкретного груза уточняйте у #[a.link(href="contacts.html") сотрудников компании].
