extends ../pug/landing-layout
include ../pug/route-components.pug

block variables
  -
    title = "Грузоперевозки Владивосток — Хабаровск"
    pagePath = "vladivostok-khabarovsk.html"
    landingOrigin = "vvo"
    landingDestination = "khb"
    landingPhone = business.terminals.vvo.phones.find((item) => item.role?.startsWith("Отправка"))
    description = "Перевозка грузов из Владивостока в Хабаровск: обычно 1 сутки, отправления каждый рабочий день. Тарифы, забор со склада и получение на терминале или с доставкой."

block content
  -
    const origin = landingOrigin;
    const destination = landingDestination;
    const route = business.routes.find((item) => item.origin === origin && item.destination === destination);
    const sendingPhone = landingPhone;
    const receivingPhone = business.terminals.khb.phones.find((item) => item.role?.startsWith("Выдача"));
    const receptionCutoff = business.reception.match(/[0-9]{2}:[0-9]{2}/)?.[0];
    const applicationCutoff = business.applicationDeadline.match(/[0-9]{2}:[0-9]{2}/)?.[0];

  article.route-landing
    header.route-landing__hero
      .route-landing__hero-grid
        .route-landing__hero-content
          h1
            span.route-landing__title-kicker Грузоперевозки
            | #{" "}
            span.route-landing__title-route
              span.route-landing__title-city Владивосток
              span.route-landing__title-arrow(aria-hidden="true") →
              span.visually-hidden=" — "
              span.route-landing__title-city Хабаровск
          p.route-landing__lead Грузы и документы из Владивостока в Хабаровск. Сдайте груз на терминале или закажите забор со склада отправителя.
          .route-landing__facts
            span.route-landing__schedule Рейсы #{route.schedule}
            strong Обычный срок доставки — #{route.usualDays} сутки.
          p.route-landing__guarantee
            strong До #{route.days} календарных суток
            |  — гарантированный срок от приёма груза на склад.
          +routeActions(origin, destination, "hero")
          p.route-landing__hint Маршрут будет предложен в заявке. Проверьте города отправления и получения перед отправкой.
          p.route-landing__hero-contact Отправка во Владивостоке: #[+routePhone(sendingPhone, origin, destination, "hero")]
        figure.route-landing__journey
          figcaption.route-landing__eyebrow От отправителя — к получателю
          ol.route-landing__journey-stops(role="list")
            li
              span.route-landing__journey-label Отправление
              strong=tariffs.places[origin]
              span Терминал или ваш склад
            li
              span.route-landing__journey-label Перевозка
              strong Межгород
              span=route.schedule
            li
              span.route-landing__journey-label Получение
              strong=tariffs.places[destination]
              span Терминал или склад получателя
      nav.route-landing__navigation(aria-label="Разделы направления")
        a.link(href="#tariffs") Тарифы и примеры
        a.link(href="#terminals") Терминалы
        a.link(href="#dispatch") Как отправить

    section.route-landing__section.route-landing__section--tinted
      p.route-landing__eyebrow Подготовка к перевозке
      h2 Отправка с терминала или забор со склада
      .route-landing__columns
        .route-landing__card
          h3 Отправить во Владивостоке
          p Груз можно привезти на терминал или заказать машину для забора со склада отправителя. Условия и стоимость адресных услуг согласуйте с сотрудниками компании.
          p=business.packagingNotice
          p Требования и тарифы — в разделе #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") «Упаковка»].
        .route-landing__card
          h3 Получить в Хабаровске
          p В Хабаровске доступно получение на терминале или доставка до склада получателя. Условия и стоимость адресных услуг согласуйте с сотрудниками компании.
          p=business.collection
      p=business.temperature

    section#tariffs.route-landing__section
      p.route-landing__eyebrow Одна пара — свой тариф
      h2 Стоимость перевозки Владивосток — Хабаровск
      p Междугородняя перевозка. Цены включают НДС. Прайс действует с #[time(datetime=tariffs.startdate)=new Date(tariffs.startdate).toLocaleDateString("ru-RU", {timeZone: "UTC"})].
      p Стоимость зависит от массы и объёма. Сначала проверяются минимальные категории. В остальных случаях груз объёмом более 5 м³ на тонну рассчитывается по объёму, иначе — по весу.
      h3 Примеры для обычного груза
      +routeExamples(origin, destination)
      .route-landing__notice
        p Примеры включают только междугороднюю перевозку и НДС. Отдельные места не превышают 1 м³ и 1 м по каждой стороне; не выбраны ДВС, негабарит и температурный режим.
        p Забор и доставка по адресу, упаковка, погрузочно-разгрузочные работы и платное хранение в эти суммы не включены.
      h3 Подробные тарифы
      +routeTariffs(origin, destination)
      p Для перевозки негабарита действует надбавка #{Math.round((tariffs.oversizedRaisingFactor - 1) * 100)}% по условиям прайса.
      p #[a.link(href="pricing.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Полный прайс] и #[a.link(href="pricing.html#extra-services", target="_blank", rel="noopener", title="Откроется в новой вкладке") дополнительные расходы].
      +routeActions(origin, destination, "tariff")

    section#terminals.route-landing__section.route-landing__section--tinted
      p.route-landing__eyebrow Откуда и куда
      h2 Терминалы и контакты
      .route-landing__columns.route-landing__columns--terminals
        .route-landing__card
          p.route-landing__eyebrow 01 / Откуда
          h3 Сдать во Владивостоке
          p=tariffs.terminals.vvo
          +routePhone(sendingPhone, origin, destination, "terminal")
          p Отправка груза
          a.link(href="contacts.html#vvo", target="_blank", rel="noopener", title="Откроется в новой вкладке") Все контакты Владивостока
        .route-landing__card
          p.route-landing__eyebrow 02 / Куда
          h3 Получить в Хабаровске
          p=tariffs.terminals.khb
          +routePhone(receivingPhone, origin, destination, "terminal")
          p Выдача груза
          a.link(href="contacts.html#khb", target="_blank", rel="noopener", title="Откроется в новой вкладке") Все контакты Хабаровска
      p=business.collection

    section#dispatch.route-landing__section
      h2 Как организовать отправку
      ol.route-landing__steps(role="list")
        li
          h3 Подготовьте груз
          p Проверьте #[a.link(href="docs.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") документы] и #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") требования к упаковке].
        li
          h3 Согласуйте отправку
          p Выберите терминал или забор со склада, согласуйте условия и заполните заявку.
        li
          h3 Передайте груз
          p Сдайте груз на терминале или передайте его при согласованном заборе со склада отправителя.
        li
          h3 Получите в Хабаровске
          p Получите груз на терминале или согласуйте доставку до склада получателя.
      .route-landing__cutoffs
        .route-landing__cutoff
          p.route-landing__eyebrow Сдача груза
          if receptionCutoff
            p.route-landing__cutoff-time До #{receptionCutoff}
          p=business.reception
        .route-landing__cutoff
          p.route-landing__eyebrow Заявка на машину
          if applicationCutoff
            p.route-landing__cutoff-time До #{applicationCutoff}
          p=business.applicationDeadline
          p Это срок заявки на машину; он не заменяет регламент сдачи груза.
      p Обычный срок доставки — #{route.usualDays} сутки; гарантированный срок — до #{route.days} календарных суток от приёма на склад для любого принятого груза по этому направлению.
      h3 Хранение после прибытия
      +storageTerms()
      p #[a.link(href="terms.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Полные условия перевозки] · #[a.link(href="payment.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Способы оплаты]

    section.route-landing__section.route-landing__section--tinted
      h2 Вопросы по условиям
      .route-landing__faq
        details
          summary Можно ли заказать забор со склада во Владивостоке?
          p Да, можно сдать груз на терминал или заказать машину на склад отправителя. Условия и стоимость подачи согласуйте при оформлении.
        details
          summary Нужно ли заранее упаковать груз?
          p Ознакомьтесь с требованиями к упаковке. Во Владивостоке можно заказать упаковку и обрешётку; тарифы доступны на странице #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") «Упаковка»].
        details
          summary Если привезти груз после 11:00, его отправят?
          p Отправка после 11:00 возможна при наличии места на рейсе. Не считайте её гарантированной; согласуйте отправку с диспетчером.
        details
          summary Сутки — гарантированный срок?
          p Обычно доставка занимает #{route.usualDays} сутки. Гарантированный срок по этому направлению — до #{route.days} календарных суток от приёма груза на склад.
        details
          summary Цена включает доставку до склада получателя?
          p Приведённые таблицы и примеры относятся к межгороду. Доставку до склада получателя можно заказать отдельно, согласовав условия и стоимость.

    section.route-landing__closing
      p.route-landing__eyebrow Владивосток → Хабаровск
      h2 Готовы отправить груз?
      p Рассчитайте стоимость для своих параметров или переходите к оформлению заявки.
      +routeActions(origin, destination, "bottom")
      p.route-landing__hint Маршрут будет предложен в заявке. Проверьте города отправления и получения перед отправкой.
      p Отправка во Владивостоке: #[+routePhone(sendingPhone, origin, destination, "bottom")]
      p Нужно отправить из Хабаровска? Тарифы обратного направления смотрите в #[a.link(href="pricing.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") общем прайсе].
