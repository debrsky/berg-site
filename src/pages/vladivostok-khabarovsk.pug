extends ../pug/landing-layout
include ../pug/route-components.pug

block variables
  -
    title = "Грузоперевозки Владивосток — Хабаровск"
    landingId = "vvo-khb"
    description = "Перевозка грузов из Владивостока в Хабаровск: обычно за сутки, отправления по рабочим дням. Тарифы, забор со склада и получение на терминале или с доставкой."

block content
  -
    const origin = landingOrigin;
    const destination = landingDestination;
    const route = landing.schedule;
    const usualDuration = route.usualDays === 1 ? "сутки" : `${route.usualDays} сут.`;
    const sendingPhone = landingPhone;
    const receivingPhone = landing.receivingPhone;

    const pricing = {
      title: "Сколько стоит перевозка",
      intro: "Сравните свой груз с примерами для маршрута Владивосток — Хабаровск.",
      notice: [landingCopy.terminalVat, landingCopy.extrasWithPackaging],
      calculation: landingCopy.calculationDetailed,
      preamble: landingCopy.ordinaryCargo
    };

  article.route-landing
    +routeHero(origin, destination, {lead: "Доставим груз и документы. От терминала до терминала или с забором со склада отправителя и доставкой по адресу."})
      dl.route-landing__facts
        .route-landing__fact
          dt Отправления
          dd.route-landing__schedule Рейсы #{route.schedule}
        .route-landing__fact
          dt Обычно
          dd За #{usualDuration}
        .route-landing__fact
          dt Гарантированный срок
          dd До #{route.days} календарных суток
          dd.route-landing__fact-note От момента приёма груза, для любого принятого груза.

    +routeNavigation()

    +routePricing(origin, destination, pricing)

    +routeDispatch("Как отправить груз")
      ol.route-landing__steps
        li
          h3 Подготовьте груз
          p Проверьте #[a.link(href="docs.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") документы] и #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") упаковку].
        li
          h3 Согласуйте отправку
          p Выберите терминал или забор со склада. Согласуйте условия и заполните заявку.
        li
          h3 Передайте груз
          p Привезите груз на терминал или передайте водителю при согласованном заборе.
        li
          h3 Получите в Хабаровске
          p На терминале или с доставкой до склада получателя по согласованию.

    +routeOperations("Когда передать груз", {applicationTitle: "Заявка на грузоперевозку", applicationNote: "Это срок заявки на машину; он не заменяет регламент сдачи груза."})

    +routeServices("Дополнительные услуги")
      p
        strong Упаковка и обрешётка.
        |  #{business.packagingNotice} #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Требования и тарифы].
      p
        strong Забор и доставка по адресу.
        |  По согласованию. Условия и стоимость уточните у сотрудников компании.
      p=business.temperature

    +routeTerminals("Где отправить и получить")
      .route-landing__columns
        +routeTerminal(origin, destination, {code: origin, phone: sendingPhone, title: "Отправить во Владивостоке", showRole: true})

        +routeTerminal(origin, destination, {code: destination, phone: receivingPhone, title: "Получить в Хабаровске", receiving: true, showRole: true})

      p.route-landing__hint=business.collection

    +routeQuestions("Вопросы по условиям", true)
      .route-landing__faq
        details
          summary Можно ли заказать забор и доставку по адресу?
          p Да. Во Владивостоке можно заказать забор со склада отправителя, в Хабаровске — доставку до склада получателя. Условия и стоимость согласуйте при оформлении: в тарифы межгорода эти услуги не включены.
        details
          summary Нужно ли заранее упаковать груз?
          p Ознакомьтесь с требованиями к упаковке. Во Владивостоке можно заказать упаковку и обрешётку; тарифы доступны на странице #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") «Упаковка»].
        details
          summary Если привезти груз после #{business.receptionCutoff}, его отправят?
          p Отправка после #{business.receptionCutoff} возможна при наличии места на рейсе. Не считайте её гарантированной; согласуйте отправку с диспетчером.
        details
          summary Сутки — гарантированный срок?
          p Обычно доставка занимает #{usualDuration}. Гарантированный срок по этому направлению — до #{route.days} календарных суток от приёма груза для любого принятого груза.
        +routeStorageQuestion("Сколько стоит хранение после прибытия?")
      p Нужна отправка в другую сторону? #[a.link(href=landing.related[0].pagePath, target="_blank", rel="noopener", title="Откроется в новой вкладке") Хабаровск — Владивосток].
      +routeRelatedLinks()

    +routeClosing(origin, destination, sendingPhone, "Согласовать отправку с диспетчером")

    +routeMobileAction(origin, destination)
