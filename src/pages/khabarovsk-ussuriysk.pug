extends ../pug/landing-layout
include ../pug/route-components.pug

block variables
  -
    title = "Грузоперевозки Хабаровск — Уссурийск"
    landingId = "khb-uss"
    description = "Перевозка грузов и документов из Хабаровска в Уссурийск компанией «Берг». Тарифы с НДС, терминалы, забор и доставка по адресу. Дату рейса и срок согласуем перед отправкой."

block content
  -
    const origin = landingOrigin;
    const destination = landingDestination;
    const sendingPhone = landingPhone;
    const generalPhone = landing.generalPhone;
    const receivingPhone = landing.receivingPhone;

    const pricing = {
      title: "Сколько стоит доставка в Уссурийск",
      intro: "Четыре примера для маршрута Хабаровск — Уссурийск. Сравните массу и объём со своим грузом, затем рассчитайте его в калькуляторе.",
      notice: [landingCopy.terminalVat, landingCopy.ordinaryCargo, landingCopy.extras],
      calculation: landingCopy.calculation
    };

  article.route-landing
    +routeHero(origin, destination, {lead: "Транспортная компания «Берг» доставляет грузы и документы из Хабаровска в Уссурийск. Передайте груз на терминале или закажите забор со склада. Получить можно на терминале или по адресу."})
      dl.route-landing__facts
        .route-landing__fact
          dt Дата рейса и срок
          dd Согласуем перед отправкой
          dd.route-landing__fact-note Позвоните в отдел приёма в Хабаровске: уточним отправку и срок доставки вашего груза.
        .route-landing__fact
          dt Передача и получение
          dd На терминале или по адресу

    +routeNavigation()

    +routePricing(origin, destination, pricing)

    +routeDispatch("Как отправить груз")
      ol.route-landing__steps
        li
          h3 Подготовьте груз
          p Упакуйте груз до передачи. Подготовьте #[a.link(href="docs.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") документы для перевозки].
        li
          h3 Согласуйте рейс
          p Позвоните в отдел приёма в Хабаровске. Уточните дату, срок доставки и способ передачи груза.
        li
          h3 Оформите и передайте
          p Заполните заявку. Привезите груз на терминал или передайте водителю при согласованном заборе со склада.
        li
          h3 Получите в Уссурийске
          p Согласуйте время выдачи на терминале или доставку до склада получателя.

    +routeOperations("Когда подать заявку и сдать груз", {applicationTitle: "Заявка на завтра", applicationNote: "Время местное. Заявка не заменяет согласование рейса; время приёма не является расписанием отправлений."})

    +routeServices("Что согласовать дополнительно")
      p
        strong Забор и доставка по адресу.
        |  Можно заказать машину на склад отправителя в Хабаровске и доставку до склада получателя в Уссурийске. Условия и стоимость уточните при оформлении.
      p.route-landing__preparation
        strong Упакуйте груз до сдачи в Хабаровске.
        |  Проверьте #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") требования к упаковке груза] до передачи на терминал или водителю.
      p=business.temperature

    +routeTerminals("Два терминала — один маршрут")
      .route-landing__columns
        +routeTerminal(origin, destination, {code: origin, phone: sendingPhone, title: "Приём в Хабаровске", showRole: true, generalPhone: generalPhone})

        +routeTerminal(origin, destination, {code: destination, phone: receivingPhone, title: "Выдача в Уссурийске", receiving: true})

      p.route-landing__hint=business.collection

    +routeQuestions("Вопросы перед отправкой")
      .route-landing__faq
        details
          summary Когда груз отправят и доставят?
          p Дату рейса и срок доставки из Хабаровска в Уссурийск согласуйте с отделом приёма до передачи груза. Срок заявки до #{business.applicationCutoff} и время сдачи до #{business.receptionCutoff} не означают, что рейс отправляется каждый день.
        details
          summary Можно ли отправить без поездки на терминал?
          p Да, можно заказать забор со склада отправителя в Хабаровске. В Уссурийске доступна доставка до склада получателя. Эти услуги оплачиваются отдельно от перевозки между терминалами.
        details
          summary Как подготовить груз к отправке?
          p Упакуйте груз до передачи на терминал или водителю. Проверьте #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") требования к упаковке] и подготовьте документы для перевозки.
        details
          summary Что будет, если сдать груз после #{business.receptionCutoff}?
          p Отправка возможна при наличии места на рейсе. Заранее позвоните в отдел приёма, чтобы согласовать передачу груза; отправка после #{business.receptionCutoff} не гарантирована.
        +routeStorageQuestion("Когда начинается платное хранение?")
      +routeRelatedLinks()
        a.link(href=landing.related[0].pagePath, target="_blank", rel="noopener", title="Откроется в новой вкладке") Уссурийск — Хабаровск

    +routeClosing(origin, destination, sendingPhone, "Согласовать отправку из Хабаровска")

    +routeMobileAction(origin, destination)
