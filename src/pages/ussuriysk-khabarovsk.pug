extends ../pug/landing-layout
include ../pug/route-components.pug

block variables
  -
    title = "Грузоперевозки Уссурийск — Хабаровск"
    landingId = "uss-khb"
    description = "Грузоперевозки Уссурийск — Хабаровск транспортной компанией «Берг». Расчёт стоимости, адреса терминалов и контакты. Дату отправки и срок доставки согласуйте по телефону."

block content
  -
    const origin = landingOrigin;
    const destination = landingDestination;
    const sendingPhone = landingPhone;
    const receivingPhone = landing.receivingPhone;

    const pricing = {
      title: "Сколько стоит перевозка",
      intro: "Сравните свой груз с примерами для маршрута Уссурийск — Хабаровск.",
      notice: [landingCopy.terminalVat, landingCopy.extrasWithoutPackaging],
      calculation: landingCopy.calculationDetailed,
      preamble: landingCopy.ordinaryCargo
    };

  article.route-landing
    +routeHero(origin, destination, {lead: "Транспортная компания «Берг» перевозит груз и документы из Уссурийска в Хабаровск. От терминала до терминала или с забором со склада отправителя и доставкой по адресу."})
      dl.route-landing__facts
        .route-landing__fact
          dt Отправление и срок
          dd Согласуем перед отправкой
          dd.route-landing__fact-note Позвоните на терминал в Уссурийске: уточним дату рейса и срок доставки вашего груза.
        .route-landing__fact
          dt Передача и получение
          dd На терминале или по адресу

    +routeNavigation()

    +routePricing(origin, destination, pricing)

    +routeDispatch("Как отправить груз")
      ol.route-landing__steps
        li
          h3 Подготовьте груз
          p Проверьте #[a.link(href="docs.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") документы] и #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") упаковку].
        li
          h3 Согласуйте отправку
          p Выберите терминал или забор со склада. Согласуйте условия и заполните заявку.
        li
          h3 Передайте груз
          p Привезите груз на терминал или передайте водителю при согласованном заборе.
        li
          h3 Получите в Хабаровске
          p На терминале или с доставкой до склада получателя по согласованию.

    +routeOperations("Когда передать груз", {applicationTitle: "Заявка на грузоперевозку", applicationNote: "Время местное. Подача заявки не заменяет согласование даты рейса и срока доставки."})

    +routeServices("Дополнительные услуги")
      p
        strong Забор и доставка по адресу.
        |  По согласованию. Условия и стоимость уточните у сотрудников компании.
      p=business.temperature

    +routeTerminals("Где отправить и получить")
      .route-landing__columns
        +routeTerminal(origin, destination, {code: origin, phone: sendingPhone, title: "Отправить в Уссурийске"})

        +routeTerminal(origin, destination, {code: destination, phone: receivingPhone, title: "Получить в Хабаровске", receiving: true, showRole: true})

      p.route-landing__hint=business.collection

    +routeQuestions("Вопросы по условиям", true)
      .route-landing__faq
        details
          summary Можно ли заказать забор и доставку по адресу?
          p Да. В Уссурийске можно заказать забор со склада отправителя, в Хабаровске — доставку до склада получателя. Условия и стоимость согласуйте при оформлении: в тарифы межгорода эти услуги не включены.
        details
          summary Нужно ли заранее упаковать груз?
          p Да, подготовьте груз до передачи на терминал. Проверьте #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") требования к упаковке].
        details
          summary Если привезти груз после #{business.receptionCutoff}, его отправят?
          p Отправка после #{business.receptionCutoff} возможна при наличии места на рейсе. Не считайте её гарантированной; согласуйте отправку с диспетчером.
        details
          summary Когда отправят и доставят груз?
          p Дату рейса и срок доставки по направлению Уссурийск — Хабаровск согласуйте с сотрудником терминала в Уссурийске до передачи груза. Время приёма на терминал не является расписанием рейсов.
        +routeStorageQuestion("Сколько стоит хранение после прибытия?")
      +routeRelatedLinks()

    +routeClosing(origin, destination, sendingPhone, "Согласовать отправку с диспетчером")

    +routeMobileAction(origin, destination)
