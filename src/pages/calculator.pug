extends ../pug/layout
block variables
  -
    title = "Тарифный калькулятор"
    pagePath = "calculator.html"
    description = "Рассчитайте стоимость перевозки ТК Берг по направлению, весу и объёму груза с учётом выбранных дополнительных условий."
    activeNav = "calculator.html"

block head
  script(src="vendor/imask/imask.min.js")

block content
  -
    const places = tariffs.places;
    const heavyCargoPrices = tariffs.heavyCargoPrices;
    const lightCargoPrices = tariffs.lightCargoPrices;
    const minPrices = tariffs.minPrices;
    const fridgePrices = tariffs.fridgePrices;

  article
    h1.h2 Тарифный калькулятор

    form.form(name="calculator")
      p(data-route-notice, role="status", hidden)
      section.form__section
        h2.h3 Направление
        .form__section-content
          .control-group(style="display: flex; flex-wrap: wrap;")
            .control(style="width: min-content;")
              label(for="origin") Место отправления
              select#origin(name="origin")
                option(selected, value) &lt;не выбрано&gt;
                each placeName, place in places
                  option(value=place)=placeName
            .control(style="width: min-content;")
              label(for="destination") Место получения
              select#destination(name="destination")
                option(selected, value) &lt;не выбрано&gt;
                each placeName, place in places
                  option(value=place)=placeName
          p.direction-error-message(aria-live="assertive", hidden) Стоимость перевозки по данному направлению можно узнать у #[a.link(href="contacts.html") сотрудников компании], автоматический расчет тарифа не предусмотрен.

      section.form__section
        h2.h3 Характеристики груза
        .form__section-content
          .control-group.flex.flex--wrap
            .control.min-content
              label(for="weight") Вес груза, кг
              input#weight(type="text", name="weight", inputmode="decimal", style="width: 15ch;")
            .control.min-content
              label(for="volume") Объем груза, м³
              input#volume(type="text", name="volume", inputmode="decimal", style="width: 15ch;")

          .control-group
            .control
              input#ic-engine(type="checkbox", name="params[]", value="ic-engine")
              label(for="ic-engine") Это двигатель внутреннего сгорания
            .control
              input#fridge(type="checkbox", name="params[]", value="fridge")
              label(for="fridge") Необходимо соблюдение температурного режима для груза (+ или - °С)
            .control
              input#oversized(type="checkbox", name="params[]", value="oversized")
              label(for="oversized") Негабаритный груз

      section.form__section
        h2.h3 Результат расчета
        .form__section-content.calculator-result
          p.calculator-result__amount
            output(name="result", aria-live="assertive")
          p.calculation-assumption(aria-live="polite", hidden)
          p.truck-trip(aria-live="assertive", hidden) Стоимость перевозки грузов машинорейсом рассчитывается в индивидуальном порядке, обращайтесь к #[a.link(href="contacts.html") сотрудникам компании].
          p.cargo-category.calculator-result__category(aria-live="assertive", hidden)
          .calculator-result__next
            .calculator-result__copy
              p.calculator-result__title Перейти к оформлению перевозки
              p.calculator-result__hint Предложим в заявке выбранный маршрут и введённые вес и объём. Сохранённые данные не заменяются автоматически.
            .calculator-result__actions
              a.button.button--primary.calculator-result__order(href="order.html", data-calculator-order) Оформить заявку
              button.button.calculator-result__share(type="button", data-calculator-share, hidden) Поделиться расчётом
          p.calculator-result__hint(data-calculator-share-status, role="status")
          input.calculator-result__share-link(type="text", readonly, hidden, data-calculator-share-link, aria-label="Ссылка на расчёт")
    script#calculator-tariffs(type="application/json")!=JSON.stringify(tariffs, (key, value) => value === Infinity ? "Infinity" : value).replace(/</g, "\\u003c")

block scripts
  script(src="js/calculator.js")
