extends ../pug/layout
block variables
  -
    title = "О транспортной компании Берг"
    pagePath = "about.html"
    activeNav = "about.html"
    pageClass = "page--information"
    description = "Транспортная компания Берг: направления автомобильных перевозок по Дальнему Востоку, собственные площадки и услуги по подготовке груза."

block content
  article
    h1.h2 О транспортной компании «Берг»
    img.about-map(src="img/map.jpg", alt="Карта Дальнего Востока", width="472", height="630", style="display: block; float: right; max-width: 100%; height: auto;")
    p ТК Берг выполняет автомобильные грузоперевозки по Дальнему Востоку, принимает грузы и документы.
    h2.h3 Расписание перевозок
    +routeSchedule()
    h2.h3 Площадки и услуги
    p Собственные площадки находятся во Владивостоке, Уссурийске, Хабаровске и Благовещенске.
    p=business.packagingNotice
    p=business.temperature
    p=business.collection
    p Адреса и телефоны — на странице #[a.link(href="contacts.html") контактов]. Стоимость — в #[a.link(href="pricing.html") прайсе] и #[a.link(href="calculator.html") калькуляторе].
