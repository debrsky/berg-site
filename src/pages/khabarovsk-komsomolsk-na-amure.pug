extends ../pug/landing-layout
include ../pug/route-components.pug

block variables
  -
    title = "Грузоперевозки Хабаровск — Комсомольск-на-Амуре"
    pagePath = "khabarovsk-komsomolsk-na-amure.html"
    landingOrigin = "khb"
    landingDestination = "kms"
    landingPhone = business.terminals.khb.phones.find((item) => item.role?.startsWith("Приём"))
    description = "Перевозка грузов и документов из Хабаровска в Комсомольск-на-Амуре компанией «Берг». Тарифы с НДС, терминалы, забор и доставка по адресу. Дату рейса и срок согласуем перед отправкой."

block content
  -
    const origin = landingOrigin;
    const destination = landingDestination;
    const sendingPhone = landingPhone;
    const generalPhone = business.terminals[origin].phones.find((item) => !item.role);
    const receivingPhone = business.terminals[destination].phones.find((item) => item.role === "Наталья");
    const receptionCutoff = business.reception.match(/[0-9]{2}:[0-9]{2}/)?.[0];
    const applicationCutoff = business.applicationDeadline.match(/[0-9]{2}:[0-9]{2}/)?.[0];

  article.route-landing
    header.route-landing__hero
      .route-landing__hero-grid
        .route-landing__hero-content
          h1
            span.route-landing__title-kicker Грузоперевозки
            | #{" "}
            span.route-landing__title-route
              span.route-landing__title-city Хабаровск
              span.visually-hidden=" — "
              span.route-landing__title-city Комсомольск-на-Амуре
          p.route-landing__lead Транспортная компания «Берг» доставляет грузы и документы из Хабаровска в Комсомольск-на-Амуре. Передайте груз на терминале или закажите забор со склада. Получить можно на терминале или по адресу.
        .route-landing__hero-aside
          include ../img/route-khabarovsk-komsomolsk-na-amure.svg
          dl.route-landing__facts
            .route-landing__fact
              dt Дата рейса и срок
              dd Согласуем перед отправкой
              dd.route-landing__fact-note Позвоните в отдел приёма в Хабаровске: уточним отправку и срок доставки вашего груза.
            .route-landing__fact
              dt Передача и получение
              dd На терминале или по адресу
        +routeActions(origin, destination, "hero")
        p.route-landing__hint Для расчёта понадобятся вес и объём груза.

    nav.route-landing__navigation(aria-label="Разделы направления")
      a.link(href="#tariffs") Стоимость
      a.link(href="#dispatch") Как отправить
      a.link(href="#terminals") Терминалы
      a.link(href="#questions") Вопросы

    section#tariffs.route-landing__section
      h2 Сколько стоит доставка в Комсомольск-на-Амуре
      p.route-landing__intro Четыре примера для маршрута Хабаровск — Комсомольск-на-Амуре. Сравните массу и объём со своим грузом, затем рассчитайте его в калькуляторе.
      +routeExamples(origin, destination, "khabarovsk-komsomolsk-na-amure")
      .route-landing__notice
        p Между терминалами, включая НДС.
        p Примеры для обычного груза: каждое место не больше 1 м³ и 1 м по каждой стороне. Без надбавок за негабарит, ДВС и температурный режим.
        p Забор со склада, доставка по адресу, погрузочно-разгрузочные работы и платное хранение оплачиваются отдельно.
      +routeActions(origin, destination, "tariff")
      details.route-landing__disclosure
        summary Подробные тарифы и правила расчёта
        .route-landing__disclosure-content
          p Цены включают НДС. Прайс действует с #[time(datetime=tariffs.startdate)=new Date(tariffs.startdate).toLocaleDateString("ru-RU", {timeZone: "UTC"})].
          p Сначала проверяются минимальные категории по массе и объёму одновременно. В остальных случаях груз объёмом более 5 м³ на тонну рассчитывается по объёму, иначе — по весу.
          +routeTariffs(origin, destination)
          p Для перевозки негабарита действует надбавка #{Math.round((tariffs.oversizedRaisingFactor - 1) * 100)}% по условиям прайса.
          p #[a.link(href="pricing.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Полный прайс] и #[a.link(href="pricing.html#extra-services", target="_blank", rel="noopener", title="Откроется в новой вкладке") дополнительные расходы].
          button.route-landing__collapse(type="button", data-collapse-tariffs, hidden) Свернуть подробные тарифы

    section#dispatch.route-landing__section.route-landing__section--dispatch
      h2 Как отправить груз
      ol.route-landing__steps(role="list")
        li
          h3 Подготовьте груз
          p Упакуйте груз до передачи. Подготовьте #[a.link(href="docs.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") документы для перевозки].
        li
          h3 Согласуйте рейс
          p Позвоните в отдел приёма в Хабаровске. Уточните дату, срок доставки и способ передачи груза.
        li
          h3 Оформите и передайте
          p Заполните заявку. Привезите груз на терминал или передайте водителю при согласованном заборе со склада.
        li
          h3 Получите в Комсомольске-на-Амуре
          p Согласуйте время выдачи на терминале или доставку до склада получателя.

    section.route-landing__section.route-landing__section--operations(aria-labelledby="cutoffs-title")
      h2#cutoffs-title Когда подать заявку и сдать груз
      .route-landing__cutoffs
        .route-landing__cutoff
          h3 Сдача груза на терминал
          if receptionCutoff
            p.route-landing__cutoff-time До #{receptionCutoff}
          .route-landing__cutoff-detail
            p=business.reception
        .route-landing__cutoff
          h3 Заявка на завтра
          if applicationCutoff
            p.route-landing__cutoff-time До #{applicationCutoff}
          .route-landing__cutoff-detail
            p=business.applicationDeadline
            p Время местное. Заявка не заменяет согласование рейса; время приёма не является расписанием отправлений.

    section.route-landing__section.route-landing__section--services(aria-labelledby="services-title")
      h2#services-title Что согласовать дополнительно
      .route-landing__service-notes
        p
          strong Забор и доставка по адресу.
          |  Можно заказать машину на склад отправителя в Хабаровске и доставку до склада получателя в Комсомольске-на-Амуре. Условия и стоимость уточните при оформлении.
        p.route-landing__preparation
          strong Упакуйте груз до сдачи в Хабаровске.
          |  Проверьте #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") требования к упаковке груза] до передачи на терминал или водителю.
        p=business.temperature

    section#terminals.route-landing__section.route-landing__section--terminals
      h2 Два терминала — один маршрут
      .route-landing__columns
        .route-landing__terminal
          p.route-landing__terminal-label Отправление
          h3 Приём в Хабаровске
          p.route-landing__address=tariffs.terminals[origin]
          +routePhone(sendingPhone, origin, destination, "terminal")
          p.route-landing__hint=sendingPhone.role
          p.route-landing__hint Общий телефон
          +routePhone(generalPhone, origin, destination, "terminal")
          .route-landing__terminal-links
            a.link(href="https://yandex.ru/maps/?pt=135.145785,48.482212&z=17&l=map", target="_blank", rel="noopener", title="Откроется в новой вкладке") Схема проезда
            a.link(href="contacts.html#khb", target="_blank", rel="noopener", title="Откроется в новой вкладке") Все контакты
        .route-landing__terminal
          p.route-landing__terminal-label.route-landing__terminal-label--destination Получение
          h3 Выдача в Комсомольске-на-Амуре
          p.route-landing__address=tariffs.terminals[destination]
          +routePhone(receivingPhone, origin, destination, "terminal")
          p.route-landing__hint=receivingPhone.role
          .route-landing__terminal-links
            a.link(href="https://yandex.ru/maps/?pt=137.001911,50.575140&z=17&l=map", target="_blank", rel="noopener", title="Откроется в новой вкладке") Схема проезда
            a.link(href="contacts.html#kms", target="_blank", rel="noopener", title="Откроется в новой вкладке") Все контакты
      p.route-landing__hint=business.collection

    section#questions.route-landing__section.route-landing__section--questions
      h2 Вопросы перед отправкой
      .route-landing__faq
        details
          summary Когда груз отправят и доставят?
          p Дату рейса и срок доставки из Хабаровска в Комсомольск-на-Амуре согласуйте с отделом приёма до передачи груза. Срок заявки до 16:00 и время сдачи до 11:00 не означают, что рейс отправляется каждый день.
        details
          summary Можно ли отправить без поездки на терминал?
          p Да, можно заказать забор со склада отправителя в Хабаровске. В Комсомольске-на-Амуре доступна доставка до склада получателя. Эти услуги оплачиваются отдельно от перевозки между терминалами.
        details
          summary Как подготовить груз к отправке?
          p Упакуйте груз до передачи на терминал или водителю. Проверьте #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") требования к упаковке] и подготовьте документы для перевозки.
        details
          summary Что будет, если сдать груз после 11:00?
          p Отправка возможна при наличии места на рейсе. Заранее позвоните в отдел приёма, чтобы согласовать передачу груза; отправка после 11:00 не гарантирована.
        details
          summary Когда начинается платное хранение?
          +storageTerms()
      .route-landing__related
        a.link(href="terms.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Полные условия перевозки
        a.link(href="payment.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Способы оплаты

    section.route-landing__closing
      div
        h2 Рассчитайте свой груз
        p Хабаровск — Комсомольск-на-Амуре. Укажите вес и объём, чтобы узнать стоимость перевозки.
        +routeActions(origin, destination, "bottom")
      .route-landing__closing-contact
        p Согласовать отправку из Хабаровска
        +routePhone(sendingPhone, origin, destination, "bottom")

    aside.route-landing__mobile-action(aria-label="Расчёт перевозки", hidden)
      a.button.button--primary(href="calculator.html?origin=" + origin + "&destination=" + destination, target="_blank", rel="noopener", title="Откроется в новой вкладке", data-route-id=origin + "-" + destination, data-route-goal="calculator", data-cta-position="mobile") Рассчитать стоимость
