extends ../pug/layout
block variables
  -
    title = "Контакты"
    pagePath = "contacts.html"
    activeNav = "contacts.html"
    description = "Адреса площадок и телефоны ТК Берг во Владивостоке, Уссурийске, Хабаровске, Благовещенске и Комсомольске-на-Амуре. Согласование времени выдачи груза."

block head
  script(src="https://api-maps.yandex.ru/2.1/?load=Geolink&lang=ru_RU&apikey=aa281979-9e28-442a-9b8f-43fab62b25e4")
  -
    const coordinates = {
      vvo: [43.189470, 131.915753],
      uss: [43.800389, 131.915237],
      khb: [48.482212, 135.145785],
      blg: [50.273424, 127.566212],
      kms: [50.575140, 137.001911]
    };

block content
  article.contacts-page
    h1.h2 Контакты ТК Берг
    p Электронная почта: #[a(href="mailto:" + business.email)=business.email]
    each terminal, code in business.terminals
      section.section(id=code)
        h2.h3.section__header=tariffs.places[code]
        .section__content
          address
            -const ll = coordinates[code];
            -const dataBounds = JSON.stringify([[ll[0] - 0.001, ll[1] - 0.001], [ll[0] + 0.001, ll[1] + 0.001]]);
            span.ymaps-geolink(data-type="geo", data-bounds=dataBounds)=tariffs.terminals[code]
          ul.contacts-page__phone-list
            each phone in terminal.phones
              li.contacts-page__phone-list-item
                .contacts-page__phone-link
                  a(href="tel:" + phone.number)=phone.text
                span=phone.role || ''
                if phone.whatsapp
                  a(href="https://wa.me/" + phone.number.slice(1) target="_blank" rel="noopener") WhatsApp
