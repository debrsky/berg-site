extends ../pug/landing-layout
include ../pug/route-components.pug

block variables
  -
    title = "Грузоперевозки Хабаровск — Владивосток"
    landingId = "khb-vvo"
    description = "Отправка грузов из Хабаровска во Владивосток по рабочим дням. Обычно за сутки. Тарифы, терминалы, забор и доставка до склада."

block content
  -
    const origin = landingOrigin;
    const destination = landingDestination;
    const route = landing.schedule;
    const sendingPhone = landingPhone;
    const generalPhone = landing.generalPhone;
    const receivingPhone = landing.receivingPhone;
    const usualDuration = route.usualDays === 1 ? "За сутки" : `За ${route.usualDays} сут.`;

    const pricing = {
      title: "Стоимость отправки из Хабаровска",
      intro: "Для этого направления действует отдельный тариф. Стоимость зависит от массы и объёма; минимальные категории проверяются по обоим параметрам.",
      notice: [landingCopy.terminalVat, landingCopy.ordinaryCargo, landingCopy.extrasExcluded],
      calculation: landingCopy.calculationShort,
      temperature: true
    };

  article.route-landing
    +routeHero(origin, destination, {lead: "Отправляйте грузы и документы с терминала или закажите забор со склада. Во Владивостоке — получение на терминале или доставка по адресу.", kicker: "Доставка грузов", from: "из Хабаровска", to: "во Владивосток", wordedRoute: true, shipment: true, hint: "Для расчёта понадобятся вес и объём груза. Проверьте предложенный маршрут в заявке."})
      dl.route-landing__facts
        .route-landing__fact
          dt Отправления
          dd.route-landing__schedule=route.schedule
        .route-landing__fact
          dt Обычно
          dd=usualDuration
        .route-landing__fact
          dt Гарантированный срок
          dd До #{route.days} календарных суток
          dd.route-landing__fact-note От приёма груза, для любого принятого груза.

    +routeNavigation([["reception","Приём груза"],["tariffs","Стоимость"],["arrival","Получение"],["dispatch","Как отправить"],["questions","Вопросы"]])

    section#reception.route-landing__section
      h2 Где и как передать груз
      .route-landing__reception
        +routeTerminal(origin, destination, {code: origin, phone: sendingPhone, title: "Приём в Хабаровске", showRole: true, generalPhone: generalPhone, contactOnly: true})

        div
          p=business.dispatchOptions
          p.route-landing__preparation
            strong Подготовьте упаковку до сдачи груза.
            |  Проверьте требования к упаковке до передачи груза на терминал или водителю.
          .route-landing__related
            a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Требования к упаковке
            a.link(href="docs.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Документы для отправки
      +routeCutoffs({applicationTitle: "Заявка на завтра", applicationNote: "Заявка нужна и для подачи машины, и для сдачи груза на терминал. Время заявки не заменяет время фактической передачи груза."})

    +routePricing(origin, destination, pricing)

    section#arrival.route-landing__section.route-landing__section--terminals
      h2 Получение во Владивостоке
      .route-landing__reception
        +routeTerminal(origin, destination, {code: destination, phone: receivingPhone, title: "Терминал во Владивостоке", receiving: true, showRole: true, contactOnly: true})

        div
          p=business.deliveryOptions
          p=business.collection
          h3 Хранение после прибытия
          +storageTerms()

    +routeDispatch("От расчёта к заявке")
      ol.route-landing__steps
        li
          h3 Рассчитайте груз
          p Укажите массу и объём в калькуляторе. Направление — Хабаровск → Владивосток.
        li
          h3 Подготовьте отправку
          p Согласуйте отправку с терминала или забор со склада. Подготовьте документы и упаковку.
        li
          h3 Оформите заявку
          p Проверьте города отправления и получения. Укажите нужные операции и форму оплаты.
        li
          h3 Получите груз
          p Согласуйте выдачу на терминале во Владивостоке или доставку до склада получателя.
      .route-landing__related
        a.link(href="payment.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Способы оплаты
        a.link(href="terms.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") Полные условия перевозки

    +routeQuestions("Вопросы по перевозке")
      .route-landing__faq
        details
          summary Как подготовить груз к отправке?
          p До передачи груза на терминал или водителю подготовьте упаковку по #[a.link(href="package.html", target="_blank", rel="noopener", title="Откроется в новой вкладке") опубликованным требованиям].
        details
          summary Можно ли забрать груз с нашего склада?
          p Да, вместо самостоятельной сдачи на терминале можно заказать машину на склад отправителя. #{business.applicationDeadline} Условия и стоимость согласуйте при оформлении.
        details
          summary Как получить груз во Владивостоке?
          p На терминале по согласованному времени выдачи либо с доставкой до склада получателя. Доставка по адресу не включена в приведённые примеры межгорода.
        details
          summary Сутки — гарантированный срок?
          p Обычно доставка занимает #{route.usualDays === 1 ? "сутки" : route.usualDays + " сут."}. Гарантированный срок — до #{route.days} календарных суток от приёма груза для любого принятого груза. Это разные показатели.
      p Нужна отправка в другую сторону? #[a.link(href=landing.related[0].pagePath, target="_blank", rel="noopener", title="Откроется в новой вкладке") Владивосток — Хабаровск].

    +routeClosing(origin, destination, sendingPhone, "Согласовать отправку из Хабаровска")

    +routeMobileAction(origin, destination)
